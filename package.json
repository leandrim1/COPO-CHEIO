{
  "name": "copo-cheio-disk-bebidas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "vercel-build": "node scripts/migrate.mjs && npm run build",
    "typecheck": "tsc -b",
    "test": "npm run typecheck && npm run test:unit && npm run test:api",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:api": "bash tests/run-api.sh",
    "test:e2e": "bash tests/run-e2e.sh",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "emails:update-blocklist": "node scripts/update-disposable-domains.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.10.1",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.16",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
