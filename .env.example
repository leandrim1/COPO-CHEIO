# Variáveis do SERVIDOR. Não começam com VITE_, então nunca chegam ao navegador.
#
# Na Vercel elas já são cadastradas pelas integrações do projeto "copocheio".
# Para rodar no seu computador:  vercel env pull .env.local

# Neon PostgreSQL "copocheio-db" (integração Neon da Vercel)
DATABASE_URL=

# Vercel Blob "copocheio-uploads" (armazenamento de imagens)
BLOB_READ_WRITE_TOKEN=
