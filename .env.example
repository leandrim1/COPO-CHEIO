# Variáveis do SERVIDOR. Não começam com VITE_, então nunca chegam ao navegador.
# Tabela completa, com o que acontece quando faltam: docs/OPERACAO.md.
#
# Na Vercel elas já são cadastradas pelas integrações do projeto "copocheio".
# Para rodar no seu computador:  vercel env pull .env.local

# Neon PostgreSQL "copocheio-db" (integração Neon da Vercel)
DATABASE_URL=

# Vercel Blob "copocheio-uploads" (armazenamento de imagens). Duas formas, conforme o tipo do seu Blob:
#  • clássico: BLOB_READ_WRITE_TOKEN
#  • novo (OIDC): BLOB_STORE_ID  (a Vercel cuida da autenticação nas funções)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# E-mail da loja (códigos de confirmação das contas de clientes). SMTP comum: Gmail, Brevo, Resend, SES, SendGrid...
# Sem SMTP_HOST, SMTP_USER e SMTP_PASS o cadastro de clientes fica indisponível (o resto do site funciona).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=seu@gmail.com, SMTP_PASS=<senha de app>  (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Opcionais: porta (465 padrão, ou 587), "true"/"false" (padrão: true na 465) e remetente.
# MAIL_FROM só é obrigatória quando SMTP_USER não é um e-mail.
SMTP_PORT=
SMTP_SECURE=
MAIL_FROM=

# Endereço público do site, ex.: https://www.seusite.com.br  — é o que vai nos links e na logo dos e-mails (confirmação de conta,
# "esqueci a senha") e no endereço canônico das páginas. RECOMENDADO EM PRODUÇÃO: sem ela, na Vercel o servidor usa o domínio de
# produção do projeto; ele NUNCA monta esses links a partir do que o navegador manda (isso permitiria enviar um link falso).
# Fora da Vercel (seu computador) vale o endereço local.
SITE_URL=

# Deploys de teste (preview) da Vercel NÃO aplicam migrations, para não alterar o banco da loja. Só defina como 1 se o ambiente
# Preview usar um banco Neon SEPARADO, só para testes. Veja docs/OPERACAO.md ("Previews e o banco").
MIGRATE_ON_PREVIEW=

# Pagamento online (Pix) pela ValidaPay. Só liga quando as QUATRO primeiras variáveis abaixo estão definidas; sem elas o Pix online fica
# indisponível (o painel mostra o NOME das que faltam, nunca o valor). Os valores vêm do painel da ValidaPay: Integração → API (client_id e
# client_secret) e Integração → Webhooks (segredo do webhook). As credenciais de SANDBOX e de PRODUÇÃO são diferentes, e a produção só vale no
# deploy de produção da Vercel (nos deploys de teste ela é recusada de propósito). Guia completo: docs/PAGAMENTO-ONLINE.md.
# VALIDAPAY_ENV: "sandbox" (testes, nada é cobrado) ou "production".
VALIDAPAY_ENV=
VALIDAPAY_CLIENT_ID=
VALIDAPAY_CLIENT_SECRET=
VALIDAPAY_WEBHOOK_SECRET=
# Opcional: token estático do webhook (cabeçalho x-access-token), se você o definiu no cadastro do webhook na ValidaPay.
VALIDAPAY_WEBHOOK_TOKEN=
