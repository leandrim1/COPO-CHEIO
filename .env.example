# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Supabase → Project Settings → API (ou "Connect"): Project URL e a chave anon / publishable.
# NUNCA coloque a service_role / secret key aqui: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
